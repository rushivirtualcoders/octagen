# Local default: SQLite. Production: PostgreSQL via docker compose.
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://octagen:octagen_dev_only@localhost:5432/octagen"

# Sign admin session cookies (use a long random string in production)
AUTH_SECRET="replace-with-at-least-32-random-characters"

# Seeded on `npx prisma db seed` — change immediately after first login
ADMIN_EMAIL="admin@octagen.in"
ADMIN_PASSWORD="ChangeMeNow!2026"
ADMIN_NAME="Octagen Admin"

# Public site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional inquiry mail (leave empty to skip sending)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Octagen <noreply@octagen.in>"
INQUIRY_NOTIFY_EMAIL="info@octagen.in"
