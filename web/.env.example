# =============================================================================
# Octagen × Liqui-Moly — environment template
# Copy to web/.env on the server. NEVER commit real .env or secrets.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV="production"

# --- Database (PostgreSQL) ---------------------------------------------------
# Prefer private network / localhost. Do NOT expose port 5432 to the public internet.
# Format: postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public
DATABASE_URL="postgresql://octagen:CHANGE_ME_STRONG_DB_PASSWORD@127.0.0.1:5432/octagen?schema=public"

# --- Auth (required) ---------------------------------------------------------
# Generate on the server: openssl rand -base64 48
AUTH_SECRET="replace-with-at-least-32-random-characters"

# --- First admin (used by `npm run db:seed` only) ----------------------------
ADMIN_EMAIL="admin@your-domain.com"
ADMIN_PASSWORD="replace-with-strong-unique-password"
ADMIN_NAME="Octagen Admin"

# --- Public site URL (used for SEO canonicals / sitemap) ---------------------
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# --- Optional SMTP (inquiry email notify) ------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Octagen <noreply@your-domain.com>"
INQUIRY_NOTIFY_EMAIL="info@your-domain.com"

# --- Optional: only if you still use docker compose for Postgres locally -----
# POSTGRES_USER="octagen"
# POSTGRES_PASSWORD="CHANGE_ME_DB_PASSWORD"
# POSTGRES_DB="octagen"
