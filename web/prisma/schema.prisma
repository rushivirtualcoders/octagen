generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Application {
  CAR
  BIKE
  BOTH
}

enum InquiryType {
  GENERAL
  WORKSHOP
  BULK
  PRODUCT_QUOTE
}

enum InquiryStatus {
  NEW
  READ
  REPLIED
  CLOSED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ProductCategory {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String    @default("")
  sortOrder   Int       @default(0)
  active      Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id                 String           @id @default(cuid())
  name               String
  slug               String           @unique
  articleNumber      String           @unique
  application        Application
  categoryId         String
  category           ProductCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  packSizes          Json             @default("[]")
  imageUrl           String           @default("")
  shortDescription   String           @default("")
  description        String           @default("")
  benefits           Json             @default("[]")
  approvals          Json             @default("[]")
  applicationNotes   String           @default("")
  featured           Boolean          @default(false)
  published          Boolean          @default(false)
  inquiries          Inquiry[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([application, published])
  @@index([categoryId])
}

model ArticleCategory {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  active    Boolean   @default(true)
  articles  Article[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Article {
  id                 String          @id @default(cuid())
  title              String
  slug               String          @unique
  excerpt            String          @default("")
  body               String          @default("")
  author             String          @default("Octagen")
  coverImageUrl      String          @default("")
  categoryId         String
  category           ArticleCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  relatedProductIds  Json            @default("[]")
  published          Boolean         @default(false)
  publishedAt        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([published, publishedAt])
}

model Inquiry {
  id        String        @id @default(cuid())
  type      InquiryType
  name      String
  email     String
  phone     String        @default("")
  company   String        @default("")
  subject   String        @default("")
  message   String
  productId String?
  product   Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([type])
}

model SiteSetting {
  id             String   @id
  homepage       Json
  aboutLiquiMoly Json
  aboutOctagen   Json
  contact        Json
  updatedAt      DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorEmail String
  action     String
  entity     String
  entityId   String   @default("")
  createdAt  DateTime @default(now())

  @@index([entity, createdAt])
}
