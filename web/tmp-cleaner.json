\/octagen.in\/liqui-moly\/product\/diesel-particulate-filter-protector-dpf-cleaner\/"}},{"id":11666,"name":"Rapid Cleaner | Brake &#038; Parts Cleaner (Spray)","parent":0,"type":"simple","variation":"","permalink":"https:\/\/octagen.in\/liqui-moly\/product\/rapid-cleaner-brake-parts-cleaner-spray\/","sku":"9525","short_description":"<ul>\n<li>Absolutely free of chlorine<\/li>\n<li>Removes oil and grease-based contaminants<\/li>\n<li>Low surface tension<\/li>\n<li>Leaves no residues<\/li>\n<li>High proportion of active components<\/li>\n<li>Controlled evaporation free of residues<\/li>\n<li>Dissolves resin and tar-type residues<\/li>\n<li>Optimum penetration capacity<\/li>\n<li>Optimizes economical use<\/li>\n<li>Universal application<\/li>\n<li>Contains no acetone<\/li>\n<\/ul>","description":"<p><span style=\"font-weight: 400\">Removes oil, grease and dirt quickly and completely. Parts treated will be completely free of residues and fully degreased afterwards. Saves time and money and guarantees trouble-free repair work. Removes resin, oil and grease residues. Has excellent penetration properties as well as controlled evaporation, free of residues.<\/span><\/p>\n<p><span style=\"font-weight: 400\">Universal cleaner for rapid cleansing and degreasing of small components in vehicle and industrial engineering. For brakes, clutches, transmissions, and for fitting and repair work. Removes oil and grease spots from floor coverings, materials and linings.<\/span><\/p>","on_sale":false,"prices":{"price":"0","regular_price":"0","sale_price":"0","price_range":null,"currency_code":"USD","currency_symbol":"$","currency_minor_unit":2,"currency_decimal_separator":".","currency_thousand_separator":",","currency_prefix":"$","currency_suffix":""},"price_html":"","average_rating":"0","review_count":0,"images":[{"id":11697,"src":"https:\/\/octagen.in\/liqui-moly\/wp-content\/uploads\/2024\/01\/9525_Schnellreiniger_Spray_500ml_3907-removebg-preview-1.png","thumbnail":"https:\/\/octage